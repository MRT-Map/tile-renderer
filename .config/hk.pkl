amends "package://github.com/jdx/hk/releases/download/v2.13.0/hk@2.13.0#/Config.pkl"
import "package://github.com/jdx/hk/releases/download/v2.13.0/hk@2.13.0#/Builtins.pkl"
import "package://github.com/iiiii7d/hk/releases/download/v2026.11.21+2.13.0/hk@2026.11.21+2.13.0#/Hatch.pkl"
import "package://github.com/iiiii7d/hk/releases/download/v2026.11.21+2.13.0/hk@2026.11.21+2.13.0#/Misc.pkl"

local formatters = new Mapping<String, Step> {
    ["ruff_fmt"] = Hatch.check_fmt
}

local linters = new Mapping<String, Step> {
    ["ruff"] = Hatch.check_code
    ...Misc.zizmor.steps
    ["actionlint"] = Misc.actionlint
    ...Misc.poutine.steps
}
local type_checkers = new Mapping<String, Step> {
    ["pyrefly"] = Hatch.check_types
}

steps = new Mapping<String, Step | Group> {
    ...formatters
    ...linters
    ...type_checkers
}

hooks {
    ["pre-commit"] {
        fix = true
        stash = "git"
    }
}
